# Copy to .env and fill in real values.  .env is git-ignored.

# Shared HMAC signing secret. Accounting mints JWTs with it, TimeTracking
# validates them with it - the value MUST be identical for both services.
# Generate with: openssl rand -base64 48
# MUST be at least 32 bytes or both services refuse to start.
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-bytes

# Postgres superuser password. Use this one to connect from DBeaver - it can
# see across both schemas.
POSTGRES_PASSWORD=replace-me

# Per-service database logins. Each may only touch its own schema.
ACCOUNTING_DB_PASSWORD=replace-me
TIMETRACKING_DB_PASSWORD=replace-me

# Password for the bootstrap super-admin that Accounting creates on first start
# (user id 123456789, tenant 0, all roles).
#
# There is no default in the code - a default password IS the vulnerability this
# replaced. If no super-admin exists and this is unset, the service refuses to
# start with a message naming this variable.
#
# Required on EVERY start, not just the first: the service validates this before
# it looks at whether the admin already exists, so an empty value fails the
# container even on a database that was bootstrapped long ago. Keep the key in
# the Secret for the life of the deployment.
#
# The admin row itself is created only when missing, and it cannot be deleted
# (403 from DELETE /account/user/{id}), so the account is created exactly once.
# Generate with: openssl rand -base64 24
BOOTSTRAP_ADMIN_PASSWORD=replace-me

# SMTP for Attendance-AI-Assistance, which emails the work-time analysis to whoever requested the
# report. Only that service reads these.
#
# MAIL_USERNAME and MAIL_PASSWORD are the only secret ones and are the only two the Kubernetes Secret
# needs; host, port and sender live in the service's own Helm ConfigMap, because a value one service
# reads does not belong in the shared attendance-config.
#
# Leave MAIL_ENABLED=false to run the whole pipeline - consume, analyse, render - without sending
# anything. The analysis is then only logged, which is the right setting until a real account exists.
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@attendance.local

# Anthropic API key for Attendance-AI-Assistance, which calls Claude to analyse the work-time data
# before the report is rendered. Only that service reads it - accounting and timetracking never see
# it, so a compromise of either cannot spend credits.
#
# This is API billing and is entirely separate from a Claude Pro subscription. The key draws on
# prepaid credits in the Console workspace it was scoped to; set a spend limit on that workspace.
#
# Never export this in your shell profile. Claude Code ranks ANTHROPIC_API_KEY above a claude.ai
# subscription login, so a global export silently bills interactive coding sessions to these credits
# instead of the subscription. Keep it in .env, where only the container sees it.
#
# Create at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=replace-me
